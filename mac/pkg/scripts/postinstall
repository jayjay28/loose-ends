#!/bin/bash
# Runs as root, once, when the package is installed.
#
# Everything real happens in deploy/install.sh — the same script the curl
# bootstrap uses — so there is one install path and not two that drift. This
# only does the parts a package has to: work out who is actually using the
# Mac, hand them the files, and run the installer as them rather than as root.
set -uo pipefail

PAYLOAD="/usr/local/loose-ends"
LOG="/tmp/loose-ends-install.log"
exec >>"$LOG" 2>&1
echo "--- postinstall $(date) ---"

# The installing user, not root. `stat` on the console device is the reliable
# way to ask: SUDO_USER is unset for a GUI install, and $USER is root.
USER_NAME="$(stat -f%Su /dev/console)"
USER_HOME="$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory | awk '{print $2}')"
USER_UID="$(id -u "$USER_NAME")"
echo "installing for $USER_NAME ($USER_UID) at $USER_HOME"

# The engine writes a database, a venv and logs. Root-owned files it cannot
# write would fail later and confusingly, so hand the whole tree over now.
chown -R "$USER_NAME" "$PAYLOAD"

# The menu bar app is part of the package payload; put it where apps live.
if [ -d "$PAYLOAD/Loose Ends.app" ]; then
  rm -rf "/Applications/Loose Ends.app"
  mv "$PAYLOAD/Loose Ends.app" "/Applications/Loose Ends.app"
  chown -R "$USER_NAME" "/Applications/Loose Ends.app"
  echo "menu bar app installed to /Applications"
else
  # Not a missing file so much as a misplaced one: if pkgbuild ever marks the
  # bundle relocatable again, the Installer will have written it over some
  # other copy on this Mac and left nothing here. Silence is how that went
  # unnoticed the first time.
  echo "WARNING: no app at $PAYLOAD/Loose Ends.app — nothing moved."
  echo "  if the package contains one, it was relocated over an existing copy;"
  echo "  check BundleIsRelocatable in mac/pkg/build-pkg.sh."
fi

# An engine already installed from somewhere else is somebody's working
# setup — a source checkout, most likely — and a package must not quietly
# repoint it at its own payload. Install the files, leave the running engine
# alone, and say so.
EXISTING="$USER_HOME/Library/LaunchAgents/com.looseends.api.plist"
if [ -f "$EXISTING" ] && ! grep -q "$PAYLOAD" "$EXISTING"; then
  echo "an engine is already installed from another location:"
  grep -o "cd [^ ]*" "$EXISTING" | head -1
  echo "leaving it alone. To switch it to this one, run:"
  echo "  $PAYLOAD/backend/deploy/uninstall.sh && $PAYLOAD/backend/deploy/install.sh"
  # Their engine, so their port — the installer takes PORT= overrides and the
  # plist is the only record of which one was used.
  PORT="$(sed -n 's/.*--port \([0-9][0-9]*\).*/\1/p' "$EXISTING" | head -1)"
  launchctl asuser "$USER_UID" sudo -u "$USER_NAME" \
    open "http://localhost:${PORT:-8000}/setup" 2>/dev/null || true
  exit 0
fi

# Run the real installer as the user: it builds the venv, writes the launch
# agent into *their* LaunchAgents, and opens the wizard in their browser.
# `launchctl asuser` puts it in their GUI session, which is what a launch
# agent and an `open` both require.
launchctl asuser "$USER_UID" sudo -u "$USER_NAME" \
  /bin/bash "$PAYLOAD/backend/deploy/install.sh"
STATUS=$?
echo "install.sh exited $STATUS"

# Report on what is true, not on what the installer returned.
#
# A non-zero exit does not mean nothing works — the wizard being unfinished
# looks the same from here — and this script used to answer that by exiting 0
# unconditionally, which meant a Mac that could not build a runtime at all
# still showed "Installation Successful" over a machine where nothing had been
# installed. The engine exists if its interpreter and its launch agent exist,
# so ask those two questions instead.
if [ -x "$PAYLOAD/backend/.venv/bin/python" ] \
   && [ -f "$USER_HOME/Library/LaunchAgents/com.looseends.api.plist" ]; then
  echo "engine installed"
  exit 0
fi

# It genuinely did not install. Say why in a window the person will actually
# see: nothing is running to serve a page, and the log is in /tmp where no one
# looks. macOS will show its own failure dialog on the way out.
NOTE="$USER_HOME/Desktop/Loose Ends — install failed.txt"
{
  echo "Loose Ends could not finish installing."
  echo
  echo "The files were copied, but the engine's Python runtime was not built,"
  echo "so there is nothing to run yet. Almost always this is the network:"
  echo "the installer downloads a self-contained Python when the Mac has no"
  echo "developer tools, and that download has to reach astral.sh."
  echo
  echo "Try again with a working connection — installing a second time is"
  echo "safe and picks up where this left off."
  echo
  echo "The full log of what happened:"
  echo "  $LOG"
} > "$NOTE" 2>/dev/null && chown "$USER_NAME" "$NOTE" 2>/dev/null
launchctl asuser "$USER_UID" sudo -u "$USER_NAME" open "$NOTE" 2>/dev/null || true
exit 1
